# -------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
*.class
.mvn/

# Eclipse
.classpath
.project
.settings/
.apt_generated/
.factorypath
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# VS Code
.vscode/

