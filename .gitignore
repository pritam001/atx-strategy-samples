# =======================================================
# 1. BUILD ARTIFACTS & MAVEN METADATA
# =======================================================
# Maven standard output and build directories
/target/
/build/
**/target/
**/build/
# Maven wrapper files (only ignore if generating in target)
!.mvn/wrapper/maven-wrapper.jar

# Generated POM files from flatten/release plugins
*.flattened-pom.xml
# Ignores all .flattened-pom.xml files, even those nested in submodules
**/.flattened-pom.xml
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
dependency-reduced-pom.xml
release.properties
buildNumber.properties

